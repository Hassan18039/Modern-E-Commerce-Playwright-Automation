{
    "default": {
        "require": [
            "Steps/**/*.ts",
            "Fixtures/**/*.ts",
            "Hooks/**/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "paths": [
            "Features/**/*.feature"
        ],
        "format": [
            "progress",
            "html:reports/cucumber-report.html"
        ]
    }
}